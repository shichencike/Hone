// macro_demo.hn - 宏定义演示（表达式宏 + 语句宏）
// 期望输出：
//   9
//   6
//   0
//   7
//   hello macro
//   12
//   tick tick
//   16
//   3
//
// 语法：
//   macro 名称(形参...) => 表达式;    // 表达式宏，用于表达式位置
//   macro 名称(形参...) { 语句... }   // 语句宏，展开为独立作用域代码块
//
// 安全约定（编译期校验，越界用法报 H106）：
//   1. 宏必须定义在程序顶层，且先定义后使用；
//   2. 宏体在定义点展开 ⇒ 宏只能引用更早定义的宏，天然不可能无限展开；
//   3. 纯 AST 替换（非文本替换），无运算符优先级陷阱；
//   4. 宏名不能与函数/结构体/类/枚举或其他宏重名；
//   5. 实参个数必须与形参一致；
//   6. 语句宏展开为独立作用域块，体内声明的变量不会泄漏到调用处；
//      体内禁止 return / goto / label / 嵌套 macro，break/continue 只允许出现在宏体自身的循环里。

// ── 表达式宏 ──────────────────────────────────────────────────────
macro SQ(x) => x * x;
macro ADD3(a, b, c) => a + b + c;
macro CLAMP0(v) => v < 0 ? 0 : v;

print(SQ(3));
print(ADD3(1, 2, 3));
print(CLAMP0(-5));
print(CLAMP0(7));

// ── 语句宏：自带语句序列 ──────────────────────────────────────────
macro SAY(msg) { print(msg); }
macro INC(x) { x = x + 1; }          // 形参作赋值目标：实参须是裸变量名
macro REPEAT2(body_val) {
    k = 0;
    while (k < 2) {
        print(body_val);
        k = k + 1;
    }
}

SAY("hello macro");

i = 10;
INC(i);
INC(i);
print(i); // 12

REPEAT2("tick");

// ── 宏引用更早定义的宏（定义点展开，无环）─────────────────────────
macro QUAD(x) => SQ(SQ(x));
print(QUAD(2)); // (2²)² = 16

// ── 语句宏内部变量不泄漏 ──────────────────────────────────────────
macro COUNT_TO3() {
    inner = 0;
    while (inner < 3) { inner = inner + 1; }
    print(inner);
}
COUNT_TO3();
