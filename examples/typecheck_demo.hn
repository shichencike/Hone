// typecheck_demo.hn - is_int / is_float 等类型判断演示
// 期望输出：
//   true
//   false
//   false
//   true
//   true
//   false

a = 42;
b = 3.14;
s = "hello";
l = [1, 2];

print(is_int(a));     // true
print(is_int(b));     // false
print(is_float(a));   // false
print(is_float(b));   // true
print(is_str(s));     // true
print(is_list(l));    // true
print(is_bool(true)); // true
