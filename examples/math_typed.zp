// --dll 类型映射测试：int → int64_t / float → double / bool → bool / str → const char*
fn add(a : int, b : int) -> int {
    return a + b;
}

fn avg(a : float, b : float) -> float {
    return (a + b) / 2.0;
}

fn is_positive(x : int) -> bool {
    return x > 0;
}

// str 参数 + str 拼接 + str 返回值（经 static 缓冲）
fn greet(name : str) -> str {
    return "你好, " + name + "!";
}

// str 比较（strcmp）
fn same(a : str, b : str) -> bool {
    return a == b;
}

@export add;
@export avg;
@export is_positive;
@export greet;
@export same;
