// hone_lib/math.hn - 数学标准库（用 Hone 编写）
// 用法: import "math" from "./hone_lib/math.hn";
// 函数统一 math_ 前缀，import as 可整体改前缀

// 限制 x 到 [lo, hi] 区间
fn math_clamp(x : int, lo : int, hi : int) -> int {
    if (x < lo) { return lo; }
    if (x > hi) { return hi; }
    return x;
}

// 是否为偶数
fn math_is_even(n : int) -> bool {
    return n % 2 == 0;
}

// 是否为奇数
fn math_is_odd(n : int) -> bool {
    return n % 2 == 1;
}

// 最大公约数（欧几里得算法）
fn math_gcd(a : int, b : int) -> int {
    while (b != 0) {
        t = b;
        b = a % b;
        a = t;
    }
    return a;
}

// 阶乘（迭代）
fn math_factorial(n : int) -> int {
    r = 1;
    i = 1;
    while (i <= n) {
        r = r * i;
        i = i + 1;
    }
    return r;
}

// 斐波那契（递归）
fn math_fib(n : int) -> int {
    if (n <= 1) { return n; }
    return math_fib(n - 1) + math_fib(n - 2);
}
