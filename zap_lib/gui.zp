// zap_lib/gui.zp - 图形界面库（浏览器渲染 + 本地 HTTP 服务器双向交互）
// 依赖 v0.3.0 新增内置函数：server.listen / server.poll / server.respond
// 用法: import "gui" from "./zap_lib/gui.zp";
// 约定: 脚本必须定义 `fn on_event(id, value) -> str` 处理界面事件，返回值按 JSON 协议解释：
//   {"update": [[元素id, 新文本], ...]}  → 更新页面元素文本
//   {"alert": "消息"}                     → 弹窗提示
//   其他文本                              → 显示在页面底部状态栏
// 控件构造: gui_button / gui_label / gui_input / gui_select / gui_html
// 运行: gui_run("标题", [控件列表]) 自动启动本地服务器并打开浏览器（Ctrl+C 退出）

// 按键取字典值（Zap 无 d["k"] 索引语法，遍历实现；键不存在返回 ""）
fn gui_dict_get(d, key : str) {
    for k, v in d {
        if (k == key) { return v; }
    }
    return "";
}

// ---------- 控件构造 ----------

fn gui_button(id : str, label : str) {
    return {"type": "button", "id": id, "label": label};
}

fn gui_label(id : str, text : str) {
    return {"type": "label", "id": id, "text": text};
}

fn gui_input(id : str, label : str, placeholder : str) {
    return {"type": "input", "id": id, "label": label, "placeholder": placeholder};
}

fn gui_select(id : str, label : str, options) {
    return {"type": "select", "id": id, "label": label, "options": options};
}

fn gui_html(html : str) {
    return {"type": "html", "html": html};
}

// ---------- 控件 dict → HTML 片段 ----------

fn gui_widget_html(w) -> str {
    t = gui_dict_get(w, "type");
    id = gui_dict_get(w, "id");
    if (t == "button") {
        label = gui_dict_get(w, "label");
        return "<button id='" + id + "' class='btn' onclick=\"post('" + id + "','')\">" + to_str(label) + "</button>";
    }
    if (t == "label") {
        text = gui_dict_get(w, "text");
        return "<div id='" + id + "' class='lbl'>" + to_str(text) + "</div>";
    }
    if (t == "input") {
        label = gui_dict_get(w, "label");
        ph = gui_dict_get(w, "placeholder");
        return "<div class='row'><label>" + to_str(label) + "</label><input id='" + id + "' placeholder='" + to_str(ph) + "' onchange=\"post('" + id + "', this.value)\"></div>";
    }
    if (t == "select") {
        label = gui_dict_get(w, "label");
        options = gui_dict_get(w, "options");
        opts = "";
        for o in options {
            opts = opts + "<option value='" + to_str(o) + "'>" + to_str(o) + "</option>";
        }
        return "<div class='row'><label>" + to_str(label) + "</label><select id='" + id + "' onchange=\"post('" + id + "', this.value)\">" + opts + "</select></div>";
    }
    if (t == "html") {
        return to_str(gui_dict_get(w, "html"));
    }
    return "";
}

// ---------- 完整页面 ----------

fn gui_page(title : str, widgets) -> str {
    s = "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n";
    s = s + "<title>" + title + "</title>\n";
    s = s + "<style>\n";
    s = s + "body { font-family: 'Segoe UI', 'Microsoft YaHei', sans-serif; background: #1e1e2e; color: #cdd6f4; margin: 24px; }\n";
    s = s + ".row { margin: 10px 0; display: flex; gap: 8px; align-items: center; }\n";
    s = s + ".lbl { margin: 8px 0; font-size: 16px; }\n";
    s = s + ".btn { background: #89b4fa; color: #11111b; border: none; border-radius: 6px; padding: 8px 16px; cursor: pointer; font-size: 14px; }\n";
    s = s + ".btn:hover { filter: brightness(1.1); }\n";
    s = s + "input, select { background: #313244; color: #cdd6f4; border: 1px solid #45475a; border-radius: 6px; padding: 6px 10px; font-size: 14px; }\n";
    s = s + "#status { margin-top: 16px; color: #a6e3a1; font-size: 13px; }\n";
    s = s + "</style>\n</head>\n<body>\n";
    for w in widgets {
        s = s + gui_widget_html(w) + "\n";
    }
    s = s + "<div id='status'></div>\n";
    s = s + "<script>\n";
    s = s + "async function post(id, value) {\n";
    s = s + "  const r = await fetch('/event', {method: 'POST', body: JSON.stringify({id: id, value: value})});\n";
    s = s + "  const text = await r.text();\n";
    s = s + "  apply(text);\n";
    s = s + "}\n";
    s = s + "function apply(text) {\n";
    s = s + "  try {\n";
    s = s + "    const o = JSON.parse(text);\n";
    s = s + "    if (o.update) { for (const p of o.update) { const el = document.getElementById(p[0]); if (el) el.textContent = p[1]; } }\n";
    s = s + "    if (o.alert) alert(o.alert);\n";
    s = s + "  } catch (e) { const st = document.getElementById('status'); if (st) st.textContent = text; }\n";
    s = s + "}\n";
    s = s + "</script>\n";
    s = s + "</body>\n</html>\n";
    return s;
}

// ---------- 打开浏览器（跨平台：Windows / Linux / Termux）----------

fn gui_open_browser(url : str) {
    os = env.get("OS");
    if (os == "Windows_NT") {
        sys.run("cmd /c start " + url);
    } else if (len(env.get("TERMUX_VERSION")) > 0) {
        sys.run("termux-open-url " + url);
    } else {
        sys.run("xdg-open " + url);
    }
}

// ---------- 主循环：监听 / 打开浏览器 / 分发事件 ----------

fn gui_run(title : str, widgets) {
    port = server.listen(0);
    page = gui_page(title, widgets);
    url = "http://127.0.0.1:" + to_str(port) + "/";
    gui_open_browser(url);
    print("GUI 已启动: " + url + "  （Ctrl+C 退出）");
    while (true) {
        reqs = server.poll();
        if (reqs != "[]") {
            list = json_parse(reqs);
            for req in list {
                id = gui_dict_get(req, "id");
                method = gui_dict_get(req, "method");
                path = gui_dict_get(req, "path");
                body = gui_dict_get(req, "body");
                if (method == "GET" && path == "/") {
                    server.respond(id, page);
                } else if (method == "POST" && path == "/event") {
                    ev = json_parse(body);
                    rid = gui_dict_get(ev, "id");
                    val = gui_dict_get(ev, "value");
                    r = on_event(rid, val);
                    server.respond(id, to_str(r));
                } else {
                    server.respond(id, "not found");
                }
            }
        }
        time.sleep(0.05);
    }
}
