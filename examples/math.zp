// DLL 打包示例：zap build --dll math.zp
// 注意：导出函数建议显式标注参数/返回类型（无调用点时无法自动推导）
fn add(a : int, b : int) -> int {
    return a + b;
}

fn mul(a : int, b : int) -> int {
    return a * b;
}

// 递归 + 条件（int-only，可翻译为 C）
fn fact(n : int) -> int {
    if (n <= 1) {
        return 1;
    }
    return n * fact(n - 1);
}

@export add;
@export mul;
@export fact;
