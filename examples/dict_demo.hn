// dict_demo.hn - 字典字面量与字典辅助函数演示
// 期望输出：
//   {name: hone, ver: 1, ok: true}
//   true
//   false
//   [name, ver, ok]
//   [hone, 1, true]
//   2

d = {"name": "hone", "ver": 1, "ok": true};
print(to_str(d));          // {name: hone, ver: 1, ok: true}
print(has_key(d, "name")); // true
print(has_key(d, "nope")); // false
print(to_str(keys(d)));    // [name, ver, ok]
print(to_str(values(d)));  // [hone, 1, true]
print(len(d));             // 3（键个数）
