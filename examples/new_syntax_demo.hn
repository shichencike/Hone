// new_syntax_demo.hn - 新语法演示：continue / C 风格 for / 复合赋值 / ++ -- /
// 三元表达式 / ?? 空值合并 / do-while / lambda 闭包 / 三引号原始字符串

// ---------- 1. C 风格 for 循环 ----------
print("== C 风格 for ==");
sum = 0;
for (i = 1; i <= 5; i = i + 1) {
    sum = sum + i;
}
print(sum);          // 15

// 三段均可省略：无限循环 + break 退出
n = 0;
for (;;) {
    n = n + 1;
    if (n >= 3) {
        break;
    }
}
print(n);            // 3

// ---------- 2. continue 关键字 ----------
print("== continue ==");
evens = [];
for (i = 1; i <= 6; i = i + 1) {
    if (i % 2 == 1) {
        continue;    // 跳过奇数
    }
    evens = append(evens, i);
}
print(evens);        // [2, 4, 6]

// ---------- 3. 复合赋值 ----------
print("== 复合赋值 ==");
x = 10;
x += 5;              // 15
x -= 3;              // 12
x *= 2;              // 24
x /= 4;              // 6
x %= 4;              // 2
print(x);            // 2

s = "Hone";
s += "!";
print(s);            // Hone!

// ---------- 4. 自增 / 自减 ----------
print("== 自增自减 ==");
i = 0;
i++;
print(i);            // 1（后缀）
++i;
print(i);            // 2（前缀）
print(i++);          // 2（后缀返回旧值）
print(++i);          // 4（前缀返回新值）
i--;
print(i);            // 3
--i;
print(i);            // 2

// ---------- 5. 三元表达式 ----------
print("== 三元表达式 ==");
age = 20;
label = age >= 18 ? "adult" : "minor";
print(label);        // adult
m = 7;
print(m % 2 == 0 ? "even" : "odd");   // odd
// 嵌套三元（右结合）
a = 5;
print(a > 0 ? "pos" : a < 0 ? "neg" : "zero");  // pos

// ---------- 6. ?? 空值合并 ----------
print("== 空值合并 ==");
// Hone 无 null 字面量：null 来自 void 函数调用
fn void_fn() {
}
v = void_fn();
result = v ?? "default";
print(result);       // default
v2 = 42;
print(v2 ?? 99);     // 42（非 null 取左侧）

// ---------- 7. do-while 循环 ----------
print("== do-while ==");
count = 0;
do {
    count = count + 1;
} while (count < 3);
print(count);        // 3

// 至少执行一次
k = 100;
do {
    k = k + 1;
} while (k < 3);
print(k);            // 101

// ---------- 8. lambda 匿名函数（闭包） ----------
print("== lambda ==");
double = fn(x) {
    return x * 2;
};
print(double(21));   // 42

// 捕获外围变量（按值闭包）
base = 10;
adder = fn(y) {
    return base + y;
};
print(adder(5));     // 15

// lambda 作为参数传递
fn apply(f, v) {
    return f(v);
}
print(apply(fn(n: int) { return n * n; }, 6));   // 36

// lambda 作为返回值（工厂）
fn make_adder(offset) {
    return fn(z) {
        return z + offset;
    };
}
add5 = make_adder(5);
print(add5(10));     // 15

// ---------- 9. 三引号原始字符串 ----------
print("== 三引号原始字符串 ==");
text = """line1
line2
    indented""";
print(text);
// 保留换行与缩进，不做转义处理
print(len(text));    // 24（line1\nline2\n    indented）

// ---------- 10. 函数默认参数 ----------
print("== 函数默认参数 ==");
fn greet(name, greeting = "Hello") {
    return greeting + ", " + name + "!";
}
print(greet("Hone"));            // Hello, Hone!
print(greet("Hone", "Hi"));      // Hi, Hone!

// 默认表达式可引用其前面的参数
fn repeat_char(ch, times = 3, sep = "-") {
    s = "";
    for (i = 0; i < times; i = i + 1) {
        s = s + ch;
        if (i < times - 1) {
            s = s + sep;
        }
    }
    return s;
}
print(repeat_char("*"));         // *-*-*
print(repeat_char("*", 2));      // *-*
print(repeat_char("*", 4, "+")); // *+*+*+*

// 混合：必选参数在前，默认参数在后
fn make_config(name, level = 1, verbose = false) {
    return name + ":" + to_str(level) + ":" + to_str(verbose);
}
print(make_config("app"));            // app:1:false
print(make_config("app", 3));         // app:3:false
print(make_config("app", 3, true));   // app:3:true

// lambda 同样支持默认参数
greet_fn = fn(prefix, who = "world") {
    return prefix + who;
};
print(greet_fn("hi "));      // hi world
print(greet_fn("hi ", "Hone"));  // hi Hone

