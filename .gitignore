# Rust 构建产物（所有层级）
target/

# AtomCode 代理配置（会话记忆等，不属项目代码）
.atomcode/

# WorkBuddy 会话记忆与工作区状态
.workbuddy/

# 敏感凭据（切勿提交）
token.txt
ftp.txt

# 设计规范文档
ka[.][.]md

# build --dll 生成的临时 C 源码
*.c
!tests/ka_lib/src/*.c

# 测试生成物
examples/plot_test.svg

# 官网打包产物（可再生，用 upload_ftp.py 重新打包）
官网/官网.zip

# 过期的诊断/中间产物（可随时重新生成）
build_errors.txt
rt_check.ir

# 运行时缓存
.hone_cache/
*.hzp
