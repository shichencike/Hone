// input_default_demo.hn - 输入默认值（EOF 降级）示例
// 运行：hone examples/input_default_demo.hn，然后键入输入；或管道喂入：
//       printf 'Bob\n25\n' | hone examples/input_default_demo.hn
// 演示：input / read_int 在 EOF（H306）或格式错误（H006/H007）时，
//       用 try-catch 包装返回默认值；try 块内 return 可直接向上传播。

fn read_default(prompt, fallback) {
    try {
        return input(prompt);
    } catch e {
        return fallback;   // H306 EOF → 返回默认值
    }
}

fn read_int_default(prompt, fallback) {
    try {
        return read_int(prompt);
    } catch e {
        return fallback;   // H006 格式错 / H306 EOF → 返回默认值
    }
}

name = read_default("姓名: ", "匿名");
print("你好, " + name + "!");

age = read_int_default("年龄: ", 0);
print("明年你 " + to_str(age + 1) + " 岁");

// 注意：`??` 空值合并只对 null 值生效（如 void 函数调用占位值）；
// input 在 EOF 抛的是错误而非返回 null，必须用 try-catch 捕获后降级。
