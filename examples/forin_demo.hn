// forin_demo.hn - for-in 循环演示（列表 + 字典）
// 期望输出：
//   1
//   4
//   9
//   name: hone
//   ver: 1
//   ok: true
//   6

sum = 0;
for x in [1, 2, 3] {
    print(x * x);
    sum = sum + x;
}

d = {"name": "hone", "ver": 1, "ok": true};
for k, v in d {
    print(k + ": " + to_str(v));
}

print(sum); // 1 + 2 + 3 = 6
