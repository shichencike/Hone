// FFI 变参 + 回调 + int32/float32 冒烟：libffi CIF 调用 + ffi_closure 回调
load "./tests/ffi/ext.dll" as ext {
    fn sum_ints(n: int, ...) -> int;
    fn mix_avg(ints: int, dbls: int, ...) -> float;
    fn apply_twice(cb: fn(int) -> int, x: int) -> int;
    fn call_thrice(cb: fn() -> int) -> int;
    fn take_i32(v: int32) -> int32;
    fn take_f32(v: float32) -> float32;
}

fn double_it(x) {
    return x * 2;
}

fn bump() {
    return 42;
}

print(ext.sum_ints(3, 1, 2, 3));
print(ext.sum_ints(5, 10, 20, 30, 40, 50));
print(ext.mix_avg(2, 2, 1, 3, 0.5, 1.5));
print(ext.apply_twice("double_it", 5));
print(ext.apply_twice(fn (x) { return x + 100; }, 1));
print(ext.call_thrice("bump"));
print(ext.take_i32(21));
print(ext.take_f32(3.5));
print("done");
