// 基准 9：冒泡排序（1000 个确定性伪随机整数，列表索引读写热点 a[i]）
nums = [];
i = 0;
while (i < 1000) {
    nums = append(nums, (i * 7919) % 1000000);
    i = i + 1;
}
n = len(nums);
i = 0;
while (i < n - 1) {
    j = 0;
    while (j < n - 1 - i) {
        // 列表元素类型动态：显式标注 int 便于类型检查与比较
        a : int = nums[j];
        b : int = nums[j + 1];
        if (a > b) {
            nums[j] = b;
            nums[j + 1] = a;
        }
        j = j + 1;
    }
    i = i + 1;
}
print(nums[0]);
