// test_img_lib.hn - hone_lib/img.hn 图片标准库调用测试（本地路径 import）
// 运行: hone examples/test_img_lib.hn
// 说明: 逐项断言打印 PASS/FAIL，末尾汇总失败数；同时输出两个样例文件：
//       examples/img_test.ppm（PPM P3 光栅）与 examples/img_test.svg（SVG）
import "img" from "./hone_lib/img.hn";

// Hone 函数内不可见外部变量，失败计数用 db 全局键值存储（内置 db.get/db.set）；
// check 参数统一为 str（Hone 类型锁定，避免 bool/list 混合实参）
db.set("img_failed", "0");

fn check(name : str, got : str, want : str) -> bool {
	if (got == want) {
		print("ok   " + name);
		return true;
	} else {
		print("FAIL " + name + "  got=" + got + " want=" + want);
		n = to_int(db.get("img_failed")) + 1;
		db.set("img_failed", to_str(n));
		return false;
	}
}

print("== 创建与像素读写 ==");
im = img_new(4, 3, 255, 0, 0);
check("img_new 尺寸", to_str(img_size(im)), to_str([4, 3]));
check("img_get 初始色", to_str(img_get(im, 0, 0)), to_str([255, 0, 0]));
check("img_get 越界返回黑", to_str(img_get(im, 99, 99)), to_str([0, 0, 0]));
im = img_set(im, 1, 2, 0, 255, 0);
check("img_set 写入", to_str(img_get(im, 1, 2)), to_str([0, 255, 0]));
check("img_set 其他像素不变", to_str(img_get(im, 0, 0)), to_str([255, 0, 0]));
check("img_fill 全填充", to_str(img_get(img_fill(im, 0, 0, 255), 2, 1)), to_str([0, 0, 255]));

print("== 绘图 ==");
c = img_new(8, 8, 0, 0, 0);
c = img_rect(c, 1, 1, 3, 2, 255, 255, 255);
check("img_rect 角点", to_str(img_get(c, 1, 1)), to_str([255, 255, 255]));
check("img_rect 外部", to_str(img_get(c, 0, 0)), to_str([0, 0, 0]));
c = img_line(c, 0, 0, 7, 7, 255, 0, 0);
check("img_line 起点", to_str(img_get(c, 0, 0)), to_str([255, 0, 0]));
check("img_line 终点", to_str(img_get(c, 7, 7)), to_str([255, 0, 0]));
c2 = img_new(9, 9, 0, 0, 0);
c2 = img_circle(c2, 4, 4, 3, 255, 255, 0);
check("img_circle 圆心", to_str(img_get(c2, 4, 4)), to_str([255, 255, 0]));
check("img_circle 边上", to_str(img_get(c2, 4, 7)), to_str([255, 255, 0]));
check("img_circle 角外", to_str(img_get(c2, 0, 0)), to_str([0, 0, 0]));
g = img_new(5, 1, 0, 0, 0);
g = img_gradient_h(g, [0, 0, 0], [255, 255, 255]);
check("img_gradient_h 左端", to_str(img_get(g, 0, 0)), to_str([0, 0, 0]));
check("img_gradient_h 右端", to_str(img_get(g, 4, 0)), to_str([255, 255, 255]));
gv = img_new(1, 5, 0, 0, 0);
gv = img_gradient_v(gv, [0, 0, 0], [255, 255, 255]);
check("img_gradient_v 顶端", to_str(img_get(gv, 0, 0)), to_str([0, 0, 0]));
check("img_gradient_v 底端", to_str(img_get(gv, 0, 4)), to_str([255, 255, 255]));
ck = img_new(4, 4, 0, 0, 0);
ck = img_checker(ck, 2, [255, 255, 255], [0, 0, 0]);
check("img_checker 格1", to_str(img_get(ck, 0, 0)), to_str([255, 255, 255]));
check("img_checker 格2", to_str(img_get(ck, 2, 0)), to_str([0, 0, 0]));
check("img_checker 格3", to_str(img_get(ck, 0, 2)), to_str([0, 0, 0]));

print("== 滤镜 ==");
f = img_new(2, 1, 200, 100, 50);
fg = img_grayscale(f);
p = img_get(fg, 0, 0);
check("img_grayscale 通道相等", to_str(to_int(p[0]) == to_int(p[1]) && to_int(p[1]) == to_int(p[2])), "true");
// 0.299*200+0.587*100+0.114*50 = 124.2 → 四舍五入 124
check("img_grayscale 亮度 124", to_str(to_int(p[0])), "124");
fi = img_invert(f);
check("img_invert", to_str(img_get(fi, 0, 0)), to_str([55, 155, 205]));
fb = img_brightness(f, 30);
check("img_brightness 加亮", to_str(img_get(fb, 0, 0)), to_str([230, 130, 80]));
fd = img_brightness(f, -300);
check("img_brightness 下限裁剪", to_str(img_get(fd, 0, 0)), to_str([0, 0, 0]));
fc = img_contrast(f, 0.0);
check("img_contrast 归中", to_str(img_get(fc, 0, 0)), to_str([128, 128, 128]));
ft = img_threshold(f, 128);
check("img_threshold 均值116<128 置黑", to_str(img_get(ft, 0, 0)), to_str([0, 0, 0]));
fbright = img_set(f, 0, 0, 200, 200, 200);
ft2 = img_threshold(fbright, 128);
check("img_threshold 均值200>=128 置白", to_str(img_get(ft2, 0, 0)), to_str([255, 255, 255]));

print("== 变换 ==");
t = img_new(2, 1, 255, 0, 0);
t = img_set(t, 1, 0, 0, 255, 0);
th = img_flip_h(t);
check("img_flip_h", to_str([img_get(th, 0, 0), img_get(th, 1, 0)]), to_str([[0, 255, 0], [255, 0, 0]]));
tv = img_flip_v(t);
check("img_flip_v 单行不变", to_str([img_get(tv, 0, 0), img_get(tv, 1, 0)]), to_str([[255, 0, 0], [0, 255, 0]]));
tr = img_rotate90(t);
check("img_rotate90 尺寸", to_str(img_size(tr)), to_str([1, 2]));
check("img_rotate90 像素", to_str([img_get(tr, 0, 0), img_get(tr, 0, 1)]), to_str([[255, 0, 0], [0, 255, 0]]));
tc = img_crop(t, 0, 0, 0, 0);
check("img_crop 尺寸", to_str(img_size(tc)), to_str([1, 1]));
check("img_crop 像素", to_str(img_get(tc, 0, 0)), to_str([255, 0, 0]));
ts = img_scale(t, 4, 2);
check("img_scale 尺寸", to_str(img_size(ts)), to_str([4, 2]));
check("img_scale 像素", to_str([img_get(ts, 0, 0), img_get(ts, 3, 1)]), to_str([[255, 0, 0], [0, 255, 0]]));

print("== PPM 读写 ==");
w = img_new(3, 2, 255, 0, 0);
w = img_set(w, 1, 0, 0, 255, 0);
w = img_set(w, 2, 1, 0, 0, 255);
ppm = img_to_ppm(w);
check("img_to_ppm 头含 P3", to_str(str_contains(ppm, "P3")), "true");
check("img_to_ppm 含尺寸", to_str(str_contains(ppm, "3 2")), "true");
img_save_ppm(w, "examples/img_test.ppm");
back = img_load_ppm("examples/img_test.ppm");
check("PPM 回读 尺寸", to_str(img_size(back)), to_str([3, 2]));
check("PPM 回读 像素", to_str([img_get(back, 0, 0), img_get(back, 1, 0), img_get(back, 2, 1)]),
	to_str([[255, 0, 0], [0, 255, 0], [0, 0, 255]]));

print("== SVG 输出 ==");
svg = img_to_svg(w, 1);
check("img_to_svg 含 svg 头", to_str(str_contains(svg, "<svg")), "true");
check("img_to_svg 含红色", to_str(str_contains(svg, "#ff0000")), "true");
img_save_svg(w, "examples/img_test.svg", 4);
print("已写入 examples/img_test.ppm 与 examples/img_test.svg（浏览器打开 SVG 可预览）");

print("");
failed = to_int(db.get("img_failed"));
if (failed == 0) {
	print("全部通过 (" + to_str(failed) + " 失败)");
} else {
	print("有 " + to_str(failed) + " 项失败！");
}
