// 递归函数：斐波那契
fn fib(n) {
    if (n <= 1) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

print(fib(10));  // 55

// 带显式返回类型的函数
fn add(a : int, b : int) -> int {
    return a + b;
}

print(add(20, 22));  // 42

// 参数类型由调用上下文推导
fn greet(name) {
    print("你好, " + name + "!");
}

greet("Hone");
