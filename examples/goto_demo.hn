// goto_demo.hn - 标签与跳转演示（goto / 标签）
// 期望输出：
//   0
//   1
//   2
//   4
//   flag = 1
//   sum = 6
//
// 安全规则（编译期校验，越界用法直接报错 H105）：
//   1. 标签只能在同一函数内使用，且名字在同一函数内唯一；
//   2. 只能跳到「从跳转点向外层可见」的标签 —— 无法跳进 if / 循环等内层语句块；
//   3. 禁止向前跳过变量声明/赋值，避免跳转后读到未初始化的变量。

// ── 1. 回跳：手工搭一个循环结构 ───────────────────────────────────
i = 0;
again:
print(i);
i = i + 1;
if (i < 3) { goto again; }

// ── 2. 向外层标签跳转：一次性跳出嵌套循环（等价于带标签的 break）──
total = 0;
for b in [2, 4] {
    for a in [1, 2, 3] {
        if (a == 3) { goto found; }
        total = total + b;
    }
}
found:
print(total); // b=2 那一轮累加 2+2=4，随后 a==3 直接跳出两层循环

// ── 3. 向前跳：跳过一段不产生绑定的代码 ───────────────────────────
goto skip_this;
print("这行不会执行");
skip_this:
flag = 1;
print("flag = " + to_str(flag));

// ── 4. 回跳累加 ───────────────────────────────────────────────────
n = 0;
sum = 0;
add_loop:
n = n + 1;
sum = sum + n;
if (n < 3) { goto add_loop; }
print("sum = " + to_str(sum)); // 1 + 2 + 3 = 6
